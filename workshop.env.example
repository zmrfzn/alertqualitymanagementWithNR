# Copy to workshop.env and fill in. Then run: bash wire-credentials.sh
# New Relic INGEST license key (wires the infra agent + the Node APM app)
NR_LICENSE_KEY=
# New Relic USER API key (NRAK...) — used by Terraform
NR_USER_API_KEY=
# New Relic account ID (numeric)
NR_ACCOUNT_ID=
# Region: US or EU
NR_REGION=US
